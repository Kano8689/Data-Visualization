{
  "name": "Car Sales Professional",
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#6B7280",
  "background": "#F3F4F6",
  "backgroundNeutral": "#FFFFFF",
  "tableAccent": "#F97316",

  "dataColors": [
    "#1E3A8A",
    "#F97316",
    "#3B82F6",
    "#10B981",
    "#EF4444",
    "#8B5CF6",
    "#06B6D4",
    "#F59E0B",
    "#6366F1",
    "#64748B"
  ],

  "visualStyles": {

    "*": {
      "*": {

        "title": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 16,
          "color": { "solid": { "color": "#1F2937" } }
        }],

        "labels": [{
          "fontFamily": "Segoe UI",
          "fontSize": 11,
          "color": { "solid": { "color": "#374151" } }
        }],

        "background": [{
          "show": true,
          "color": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        }],

        "border": [{
          "show": false
        }]
      }
    },

    "card": {
      "*": {

        "labels": [{
          "fontFamily": "Segoe UI",
          "fontSize": 14,
          "color": { "solid": { "color": "#6B7280" } }
        }],

        "calloutValue": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 28,
          "color": { "solid": { "color": "#1E3A8A" } }
        }]
      }
    },

    "slicer": {
      "*": {

        "items": [{
          "fontFamily": "Segoe UI",
          "fontSize": 12,
          "color": { "solid": { "color": "#1F2937" } }
        }],

        "header": [{
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 13,
          "color": { "solid": { "color": "#1E3A8A" } }
        }]
      }
    }
  }
}